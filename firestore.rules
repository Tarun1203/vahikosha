rules_version = '2';

// Chittam Enterprises — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// - Only the staff logins listed in signedIn() can read or write.
// - Customers, products, orders, service jobs, transports, receipts, Tally
//   balances, transactions, stock and open invoices, and settings can be added and edited, never deleted.
// - Message history and the change log can only be added to — never edited
//   or deleted — and each entry must carry the signed-in user's email.
// - Encryption (turned on from the app's Settings): once settings/crypto is on,
//   every write must be encrypted (carry a new "enc"), and the passphrase's
//   salt can never be swapped for another, and it can't be turned off again.
service cloud.firestore {
  match /databases/{database}/documents {
    // only these logins get in (a Firebase account anyone else creates is refused);
    // add a new staff member's email here and publish again
    function signedIn() {
      return request.auth != null && request.auth.token.email in [
        'tarunchettam12@gmail.com',
        'tally-sync@chittamenterprises.in'
      ];
    }
    function stampedBySelf() {
      return request.resource.data.by == request.auth.token.email;
    }
    function encOn() {
      return exists(/databases/$(database)/documents/settings/crypto) &&
        get(/databases/$(database)/documents/settings/crypto).data.on == true;
    }
    // a new encrypted value, not a readable write next to an old one
    function sealed() {
      return !encOn() || ('enc' in request.resource.data &&
        (resource == null || !('enc' in resource.data) || request.resource.data.enc != resource.data.enc));
    }

    match /customers/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /balances/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    // Tally transactions sent by the Windows app (for Tally Match)
    match /tallyVouchers/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    // Tally stock quantities and open invoices sent by the Windows app
    match /tallyStock/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /tallyBills/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /receipts/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /transports/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /services/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /orders/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && sealed();
      allow delete: if false;
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id != 'crypto' && sealed();
      allow delete: if false;
    }
    // whether the data is encrypted, and the check for the passphrase (never encrypted)
    match /settings/crypto {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.on == true;
      allow update: if signedIn() && request.resource.data.on == true && request.resource.data.salt == resource.data.salt;
      allow delete: if false;
    }

    // Settings → Devices: each device records itself (readable, not encrypted, so a
    // device without the passphrase still sees that it was logged out). A logout
    // (revokedAt) can't be undone or changed, and nothing is deleted.
    match /devices/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.email == request.auth.token.email &&
        !('revokedAt' in request.resource.data);
      allow update: if signedIn() &&
        (!('revokedAt' in resource.data) || request.resource.data.revokedAt == resource.data.revokedAt);
      allow delete: if false;
    }

    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && stampedBySelf() && sealed();
      allow update, delete: if false;
    }
    match /activity/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && stampedBySelf() && sealed();
      allow update, delete: if false;
    }
  }
}
